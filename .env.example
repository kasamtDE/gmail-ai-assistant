# === Gmail OAuth2 ===
# Get these from Google Cloud Console → APIs & Services → Credentials
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# === Gemini API ===
# Get from https://aistudio.google.com/apikey
# Option 1: Google AI Studio (API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Vertex AI (Native Google Cloud Auth)
# If VERTEX_PROJECT_ID is set, the app automatically switches to Vertex AI
# VERTEX_PROJECT_ID=your-google-cloud-project-id
# VERTEX_LOCATION=us-central1

# === Slack (optional) ===
# Create incoming webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=slack_webhook_here

# === Email Digest (optional) ===
# SMTP settings for sending digest via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
DIGEST_TO_EMAIL=your_email@gmail.com
